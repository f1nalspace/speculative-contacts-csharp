<Scenarios:BaseScenarioPage x:Class="SpeculativeContacts.Scenarios.AngularPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SpeculativeContacts"
      xmlns:Controls="clr-namespace:SpeculativeContacts.Controls"
      xmlns:Scenarios="clr-namespace:SpeculativeContacts.Scenarios"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Angular">

    <Grid x:Name="LayoutRoot">
        <Canvas x:Name="SceneCanvas">
            <Controls:Floor RenderTransformOrigin="0.5,0.5" Width="35" Height="50" >
                <Controls:Floor.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform X="394" Y="409"/>
                    </TransformGroup>
                </Controls:Floor.RenderTransform>
            </Controls:Floor>
            <Controls:Box RenderTransformOrigin="0.5,0.5" Width="402" Height="8" DefaultVelocity="0.0, 1000">
                <Controls:Box.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform X="83" Y="223"/>
                    </TransformGroup>
                </Controls:Box.RenderTransform>
            </Controls:Box>
        </Canvas>
    </Grid>
</Scenarios:BaseScenarioPage>
